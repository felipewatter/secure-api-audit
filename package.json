{
  "name": "secure-api-audit",
  "version": "1.1.0",
  "description": "Safe, non-destructive API security audit CLI",
  "license": "MIT",
  "author": "Felipe Watter",
  "type": "commonjs",
  "engines": {"node": ">=22"},
  "bin": {"secure-api-audit": "./dist/bin/index.js"},
